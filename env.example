# Copie ce fichier en ".env.local" pour le développement local, et reporte les
# mêmes valeurs dans Vercel (Project Settings → Environment Variables) pour la
# production. Ne jamais committer le fichier ".env.local" réel (déjà exclu par
# .gitignore) ni la clé service_role dans le code.

# Clés publiques (visibles côté navigateur — sans risque, faites pour ça)
NEXT_PUBLIC_SUPABASE_URL=https://oiosmjptmfervamjqogd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète (uniquement côté serveur — jamais préfixée NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Webhook Chariow : OBLIGATOIRES. Sans le secret, la route refuse toute requête
# (réponse 503) ; sans l'identifiant du produit, aucune vente n'ouvre d'accès.
# À renseigner dans chaque environnement Vercel qui doit recevoir des ventes.
# CHARIOW_WEBHOOK_SECRET : « Secret de signature » du Pulse (préfixe whsec_).
# CHARIOW_PRODUIT_ID_AI_WORK_KIT : identifiant du produit d'accès (prd_...).
CHARIOW_WEBHOOK_SECRET=
CHARIOW_PRODUIT_ID_AI_WORK_KIT=

# Abonnement : un produit Chariow par formule (paiement unique, période prépayée).
CHARIOW_PRODUIT_ID_ABONNEMENT_MENSUEL=
CHARIOW_PRODUIT_ID_ABONNEMENT_ANNUEL=
CHARIOW_PRODUIT_ID_ABONNEMENT_A_VIE=

# Liens de paiement affichés dans l'application (publics).
NEXT_PUBLIC_ACCESS_URL=
NEXT_PUBLIC_SUBSCRIBE_URL_MENSUEL=
NEXT_PUBLIC_SUBSCRIBE_URL_ANNUEL=
NEXT_PUBLIC_SUBSCRIBE_URL_A_VIE=
# "1" pour ouvrir l'abonnement aux nouveaux clients (fermé sinon).
NEXT_PUBLIC_ABONNEMENT_OUVERT=

# Chat du support (tawk.to), publics. Sans eux, le bouton renvoie vers l'e-mail.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=

# Formulaires de contact (Systèmes IA, Transformation IA) : envoi par Resend.
# RESEND_API_KEY : clé créée sur resend.com (API Keys).
# CONTACT_EMAIL_FROM : expéditeur sur un domaine vérifié dans Resend,
#   ex. "AI WORK KIT <contact@parlonsads.com>".
# CONTACT_EMAIL_TO : destinataire des demandes (support@parlonsads.com par défaut).
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=support@parlonsads.com
